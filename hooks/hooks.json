{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|compact|fork", "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/recover.mjs\"", "timeout": 20 }] }
    ],
    "PreCompact": [
      { "matcher": "manual|auto", "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/recover.mjs\"", "timeout": 20 }] }
    ]
  }
}
